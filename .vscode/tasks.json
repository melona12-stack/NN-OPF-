{
  // VS Code 에서 Ctrl+Shift+P → "Run Task" → 목록에서 고르면 실행된다.
  // 번호 순서대로 내려가면 된다. 괄호 안에 "n번 먼저" 라고 적힌 것은
  // 그 학습을 돌려야 결과 파일이 생겨서 그림을 그릴 수 있다는 뜻이다.

  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": " 1. 준비 — 최신 코드 받기 (git pull)",
      "type": "shell",
      "command": "git pull",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": " 2. 준비 — 환경 점검 (GPU 실연산까지)",
